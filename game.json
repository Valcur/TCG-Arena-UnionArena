{
    "name": "Union Arena",
    "menuBackgroundImage": "https://valcur.github.io/TCG-Arena-UnionArena/images/banner.jpg",
    "deckBuilding": {
        "mainFilters": [
            "aspects",
            "color",
            "rarity"
        ],
        "formats": [
            {
                "title": "Classic",
                "gameplay": "Classic",
                "deckRuleset": "Classic"
            }
        ],
        "deckRulesets": {
            "Classic": {
                "general": {
                    "min": 53,
                    "max": 53,
                    "maxPerCard": 4
                },
                "categories": [
                    {
                        "category": "AP",
                        "min": 3,
                        "max": 3
                    }
                ]
            }
        }
    },
    "gameplay": {
        "Classic": {
            "mulligan": {
                "info": "You can draw a new hand once.",
                "startingHandSize": 7,
                "mulliganCount": {
                    "max": 1
                },
                "mulliganCycle": {
                    "selectionRange": {
                        "min": 7
                    },
                    "steps": [
                        "toBottom",
                        "shuffle",
                        "draw"
                    ]
                }
            },
            "beforeGameStart": {
                "initialBoardSetup": [
                    {
                        "drawFromTop": "deck",
                        "count": 7,
                        "destination": "LifeArea"
                    }
                ]
            },
            "newTurn": {
                "drawOnStart": false,
                "drawPerTurn": 1
            },
            "tokens": [],
            "draggableTokens": [],
            "countersStartingValues": [],
            "sections": {
                "layout": {
                    "direction": "row",
                    "isSymetricalForOpponents": true,
                    "style": {
                        "gap": "3vh"
                    },
                    "content": [
                        {
                            "direction": "row",
                            "style": {
                                "justifyContent": "end"
                            },
                            "content": [
                                {
                                    "section": "LifeArea"
                                },
                                {
                                    "section": "Manager"
                                }
                            ]
                        },
                        {
                            "direction": "column",
                            "style": {
                                "width": "70vh"
                            },
                            "content": [
                                {
                                    "section": "FrontLine"
                                },
                                {
                                    "section": "EnergyLine"
                                }
                            ]
                        },
                        {
                            "direction": "row",
                            "isSymetricalForOpponents": true,
                            "content": [
                                {
                                    "section": "APReserve",
                                    "style": {
                                        "position": "absolute",
                                        "top": 0,
                                        "left": "-100vw"
                                    }
                                },
                                {
                                    "section": "Mana",
                                    "style": {
                                        "marginTop": "0",
                                        "maxWidth": "35vh",
                                        "marginRight": "auto"
                                    }
                                }
                            ]
                        }
                    ]
                },
                "categoriesAlreadyOnBoard": [
                    "AP->APReserve"
                ],
                "autoPlayFromHand": {
                    "Event": "Stack"
                },
                "autoPlayFromStack": {
                    "Event": "Discard",
                    "Character": "Discard",
                    "Site": "Discard"
                },
                "sectionsDict": {
                    "FrontLine": {
                        "isHidden": "no",
                        "height": 18,
                        "alignment": "CENTER",
                        "isHorizontalAllowed": true,
                        "isGroupForbidden": true,
                        "displayedTitle": "Front Line",
                        "noQuickActions": true,
                        "enterTapped": true
                    },
                    "EnergyLine": {
                        "isHidden": "no",
                        "height": 18,
                        "alignment": "CENTER",
                        "isHorizontalAllowed": true,
                        "isGroupForbidden": true,
                        "displayedTitle": "Energy Line",
                        "noQuickActions": true,
                        "enterTapped": true
                    },
                    "APReserve": {
                        "isHidden": "yes",
                        "height": 0,
                        "alignment": "CENTER",
                        "isHorizontalAllowed": true,
                        "isGroupForbidden": true,
                        "displayedTitle": "AP Reserve"
                    },
                    "Mana": {
                        "isHidden": "no",
                        "height": 11,
                        "alignment": "CENTER",
                        "isHorizontalAllowed": false,
                        "isGroupForbidden": false,
                        "displayedTitle": "AP Area",
                        "cardActionShortcut": {
                            "action": "NONE"
                        }
                    },
                    "LifeArea": {
                        "isHidden": "yes",
                        "height": 11,
                        "alignment": "DECK",
                        "isGroupForbidden": true,
                        "displayedTitle": "Life Area"
                    },
                    "Manager": {
                        "type": "custom",
                        "defaultValue": {
                            "energy": 0
                        },
                        "blueprint": {
                            "type": "div",
                            "props": {
                                "className": "position-absolute top-0 start-0 box-container",
                                "style": {
                                    "width": "8rem",
                                    "display": "none",
                                    "marginLeft": "20vh"
                                }
                            },
                            "children": "{{ game.data.Manager.energy }}"
                        },
                        "events": {
                            "onNewTurn": "await onNewTurn()"
                        }
                    }
                }
            }
        }
    },
    "defaultRessources": {
        "backgrounds": [
            "https://valcur.github.io/TCG-Arena-UnionArena/images/background01.jpg",
            "https://valcur.github.io/TCG-Arena-UnionArena/images/background02.jpg"
        ],
        "decksUrl": ""
    },
    "customHelp": "Rules: https://www.unionarena-tcg.com/na/pdf/rule_manual.pdf\n\nThanks to ExBusrt.dev for making all the cards available.",
    "cards": {
        "dataUrl": "https://valcur.github.io/TCG-Arena-UnionArena/cards.json",
        "cardBack": "https://valcur.github.io/TCG-Arena-UnionArena/images/cardBack.jpg"
    },
    "scriptsUrls": [
        "https://valcur.github.io/TCG-Arena-UnionArena/functions.jsx"
    ]
}